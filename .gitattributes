# 换行符钉死，避免 core.autocrlf=true 把文件反复转换。
# 事故：app/public/polish.css 曾被转成 `\r\r\r\r\n`（435 行全中招），
#       浏览器能容错所以没暴露，但 diff 与补丁脚本都会因此失配。

# 本项目自有文件统一 LF
app/public/polish.css -text
src/** -text
admin/src/** -text
tests/** -text
scripts/** -text
*.md -text

# 生成产物：CI 会在 Linux 上 `npm run api:generate` 后要求 `git diff --quiet generated/`。
# 生成器固定输出 LF，若在 Windows 上被 autocrlf 转成 CRLF 再入库，
# 这条检查会永远红——所以这里钉死 -text，禁止任何换行转换。
generated/** -text

# 来自上游、原样复用的文件保持入库时的字节（同步脚本按原文替换，不能被改写）
app/public/** -text
app/functions/** -text
app/migrations/** -text
