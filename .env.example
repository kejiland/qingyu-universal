# ============================================================
# 轻语博客 · 自托管通用版 环境变量
# ------------------------------------------------------------
# 复制为 .env 后按需修改：cp .env.example .env
# 一键部署脚本（deploy/install.sh）会自动生成 .env 并填充随机密钥。
# ============================================================

# ---------- 服务 ----------
# Caddy 使用的对外域名（留空则用 localhost 自签证书；仅 Docker 部署需要）
SITE_DOMAIN=
# 监听端口与地址（Caddy 反代时保持 127.0.0.1 即可）
PORT=8787
HOST=127.0.0.1

# 站点对外地址（重要：用于 RSS / Sitemap / 邮件链接 / CORS 白名单）
SITE_URL=http://localhost:8787

# 数据目录（SQLite 数据库、上传文件、备份都放这里）
DATA_DIR=./data

# 是否信任上游反向代理注入的客户端 IP 头（Caddy/Nginx 后面填 1，直连填 0）
TRUST_PROXY=1

# ---------- 管理员 ----------
# 首次初始化安装密钥（浏览器打开 /admin 时要求填写；留空则允许任意人初始化，不推荐）
BLOG_ADMIN_SETUP_KEY=

# 可选：长期写入令牌（用于脚本/CI 调用写接口，避免登录）
BLOG_WRITE_TOKEN=

# 可选：预览链接签名密钥（留空自动用安装密钥派生）
BLOG_PREVIEW_SECRET=

# 可选：管理员邮箱 / 邮件发件人
BLOG_ADMIN_EMAIL=
BLOG_MAIL_FROM=
BLOG_MAIL_REPLY_TO=

# ---------- 对象存储（可选）----------
# 媒体与音乐文件。留空则使用本地磁盘（data/uploads）。
# 支持任何 S3 兼容服务：Cloudflare R2 / MinIO / AWS S3 / Backblaze B2 / 阿里云 OSS...
# 注意：R2 的 region 固定为 auto；MinIO 通常为 us-east-1；AWS 填真实区域。
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_MEDIA_BUCKET=
S3_MEDIA_PUBLIC_BASE=
S3_MUSIC_BUCKET=
S3_MUSIC_PUBLIC_BASE=
S3_BACKUP_BUCKET=

# ---------- 邮件（可选）----------
# 二选一：SMTP（通用）或 Resend（云端）。都留空则关闭订阅邮件功能。
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=0
RESEND_API_KEY=

# ---------- AI（可选）----------
# 任何 OpenAI 兼容接口：OpenAI / DeepSeek / Groq / SiliconFlow / Ollama / LocalAI / vLLM
# 留空则关闭 AI 功能（前端自动隐藏），不影响其它功能。
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
BLOG_AI_ENABLED=
BLOG_AI_PUBLIC=

# ---------- 其它 ----------
# 统计来源国家码（需要反向代理注入 CF-IPCountry / X-Country-Code 头）
GEOIP_HEADER=CF-IPCountry

# ---------- 日志 ----------
# 日志级别：trace / debug / info / warn / error / fatal
LOG_LEVEL=info
# 1 = 彩色人类可读输出（本地开发）；0 = 结构化 JSON（生产 / 日志采集）
LOG_PRETTY=0

# ---------- 调度 ----------
# 定时任务时区（默认 UTC，与 Cloudflare Cron 行为一致）
CRON_TIMEZONE=UTC
# 自动备份的 cron 表达式（默认每天 19:00 UTC = 北京时间 03:00）
BACKUP_CRON=0 19 * * *
# 多实例部署时，只有 INSTANCE_ID=1 的实例执行定时任务
INSTANCE_ID=1

# ---------- API 契约 ----------
# 响应 schema 校验强度：
#   off    = 关闭（生产默认，无额外开销）
#   warn   = 不一致时打日志但仍返回原响应（开发默认，便于发现契约漂移）
#   strict = 不一致时返回 500 并把差异写进响应体（测试用）
# 契约与文档见 docs/API.md，接口文档见 /openapi.json
API_VALIDATE_RESPONSES=
