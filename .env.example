# ============================================================
# 轻语博客 · 自托管通用版 环境变量
# ------------------------------------------------------------
# 复制为 .env 后按需修改：cp .env.example .env
# 一键部署脚本（deploy/install.sh）会自动生成 .env 并填充随机密钥。
# ============================================================

# ---------- 服务 ----------
# Caddy 使用的对外域名（留空则用 localhost 自签证书；仅 Docker 部署需要）
SITE_DOMAIN=
# 监听端口与地址（Caddy 反代时保持 127.0.0.1 即可）
PORT=8787
HOST=127.0.0.1

# 站点对外地址（重要：用于 RSS / Sitemap / 邮件链接 / CORS 白名单）
SITE_URL=http://localhost:8787

# 数据目录（SQLite 数据库、上传文件、备份都放这里）
DATA_DIR=./data

# 可选：PostgreSQL 连接串。留空使用 SQLite；填写后运行时切换到 PostgreSQL。
# DATABASE_URL=postgres://user:pass@host:5432/qingyu
DATABASE_URL=

# ---------- 内置 PostgreSQL（可选）----------
# 只有 COMPOSE_PROFILES 里包含 postgres 时，compose 才会把数据库容器一起拉起。
# 用 deploy/install.sh --db postgres 安装时会自动生成下面这些值（随机密码），
# 手动 docker compose 部署想用内置 PostgreSQL 时才需要自己填：
# COMPOSE_PROFILES=postgres
# POSTGRES_DB=qingyu
# POSTGRES_USER=qingyu
# POSTGRES_PASSWORD=

# 是否信任上游反向代理注入的客户端 IP 头（Caddy/Nginx 后面填 1，直连填 0）
TRUST_PROXY=1

# ---------- 管理员 ----------
# 首次初始化安装密钥（浏览器打开 /admin 时要求填写；留空则允许任意人初始化，不推荐）
BLOG_ADMIN_SETUP_KEY=

# 可选：长期写入令牌（用于脚本/CI 调用写接口，避免登录）
BLOG_WRITE_TOKEN=

# 可选：预览链接签名密钥（留空自动用安装密钥派生）
BLOG_PREVIEW_SECRET=

# 可选：管理员邮箱 / 邮件发件人
BLOG_ADMIN_EMAIL=
BLOG_MAIL_FROM=
BLOG_MAIL_REPLY_TO=

# ---------- 后台界面 ----------
# /admin 默认使用上游原生后台（app/public/admin.js，与 Cloudflare 版同一套 UI/布局/样式）。
# 置 1 才改为挂载 Vue 新版后台（需要 admin/dist 构建产物），会遮住上游后台，仅用于对照排障。
ADMIN_SPA=

# ---------- 对象存储（可选）----------
# 媒体与音乐文件放哪。
#
# 【默认】全部留空 = 存在**服务器本机磁盘**：<DATA_DIR>/uploads/{media,music,og}。
#         /media/* /music/* /og/* 由本站直接对外提供（支持 Range，音乐可拖动进度）。
#         这三条本地读取路由是**常驻**的：即使后来切到对象存储，
#         库里已有相对地址（/media/x.png）的老文件仍由本机继续服务，不会 404。
#
# 【切到第三方云端】把下面 S3_* 填齐（端点 + Access Key + Secret 三者齐全才算启用）。
#         支持任何 S3 兼容服务：Cloudflare R2 / MinIO / AWS S3 / Backblaze B2 /
#         阿里云 OSS / 腾讯云 COS / 七牛 …
#         注意：R2 的 region 固定为 auto；MinIO 通常为 us-east-1；AWS 填真实区域。
#
# 【推荐路径】不用改这个文件：登录后台 → 设置 → 存储，可视化填写并「测试连通性」，
#         保存后**立即生效、无需重启**；还能一键把本机已有文件迁移上云
#         （逐对象上传，确认进桶后才改写库内地址；默认保留本地副本）。
#         后台配置优先于这里的环境变量 —— 本段只在首次部署时充当默认值。
#
# 密钥安全：S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY 只在本进程内使用；
#         后台读接口永远只回传打码值（first4****last4）。也别把它们写进公开的
#         /api/settings —— 那是匿名可读且带缓存头的接口（存储配置走独立表）。
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_MEDIA_BUCKET=
# 媒体公开域名：必须是**可匿名读取**的地址，否则前台图片打不开
# （形如 https://img.example.com 或 https://pub-xxxx.r2.dev）
S3_MEDIA_PUBLIC_BASE=
# 音乐桶 / 域名留空时自动沿用媒体桶 / 媒体域名
S3_MUSIC_BUCKET=
S3_MUSIC_PUBLIC_BASE=
# 备份桶留空时沿用媒体桶
S3_BACKUP_BUCKET=

# ---------- 邮件（可选）----------
# 二选一：SMTP（通用）或 Resend（云端）。都留空则关闭订阅邮件功能。
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=0
RESEND_API_KEY=

# ---------- AI（可选）----------
# 任何 OpenAI 兼容接口：OpenAI / DeepSeek / Groq / SiliconFlow / Ollama / LocalAI / vLLM
# 留空则关闭 AI 功能（前端自动隐藏），不影响其它功能。
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
BLOG_AI_ENABLED=
BLOG_AI_PUBLIC=

# ---------- 其它 ----------
# 统计来源国家码（需要反向代理注入 CF-IPCountry / X-Country-Code 头）
GEOIP_HEADER=CF-IPCountry

# 可选：Redis / Valkey 连接地址。留空则使用 SQLite KV。
# 多实例部署建议配置；Redis 短暂不可用时会自动回退本地 KV。
REDIS_URL=

# ---------- 日志 ----------
# 日志级别：trace / debug / info / warn / error / fatal
LOG_LEVEL=info
# 1 = 彩色人类可读输出（本地开发）；0 = 结构化 JSON（生产 / 日志采集）
LOG_PRETTY=0

# ---------- 后台操作日志（audit_log）保留策略 ----------
# 留空用内置默认：最多 5000 条、只留最近 90 天。
# 超出任一上限即自动裁剪（写入时按 50 条节流 + 每次读取兜底），无需手动维护。
# 注意：AUDIT_MAX_ROWS 低于 100 会被忽略（防止误配置成 0 把审计全删了）。
AUDIT_MAX_ROWS=
AUDIT_RETENTION_DAYS=

# ---------- 调度 ----------
# 定时任务时区（默认 UTC，与 Cloudflare Cron 行为一致）
CRON_TIMEZONE=UTC
# 自动备份的 cron 表达式（默认每天 19:00 UTC = 北京时间 03:00）
BACKUP_CRON=0 19 * * *
# 多实例部署时，只有 INSTANCE_ID=1 的实例执行定时任务
INSTANCE_ID=1

# ---------- API 契约 ----------
# 响应 schema 校验强度：
#   off    = 关闭（生产默认，无额外开销）
#   warn   = 不一致时打日志但仍返回原响应（开发默认，便于发现契约漂移）
#   strict = 不一致时返回 500 并把差异写进响应体（测试用）
# 契约与文档见 docs/API.md，接口文档见 /openapi.json
API_VALIDATE_RESPONSES=
