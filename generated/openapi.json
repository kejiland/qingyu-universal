        "properties": {
          "ok": {
            "type": "boolean",
            "const": true
          },
          "posts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PostSummary"
            }
          }
        },
        "required": [
          "ok",
          "posts"
        ],
        "additionalProperties": false
      },
      "PostSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "excerpt": {
            "type": "string"
          },
          "cover": {
            "type": "string"
          },
          "ogImage": {
            "type": "string"
          },
          "pinned": {
            "type": "boolean"
          },
          "protected": {
            "type": "boolean"
          },
          "category": {
            "type": "string"
          },
          "series": {
            "type": "string"
          },
          "author": {
            "type": "string"
          },
          "seriesOrder": {
            "type": "number"
          },
          "status": {
            "type": "string",
            "enum": [
              "published",
              "draft",
              "scheduled"
            ]
          },
          "publishAt": {
            "type": [
              "number",
              "null"
            ]
          },
          "seo": {
            "$ref": "#/components/schemas/Seo"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "search": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "date",
          "excerpt",
          "cover",
          "ogImage",
          "pinned",
          "protected",
          "category",
          "series",
          "author",
          "seriesOrder",
          "status",
          "publishAt",
          "seo",
          "tags"
        ],
        "additionalProperties": false
      },
      "Seo": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "desc": {
            "type": "string"
          },
          "canonical": {
            "type": "string"
          },
          "noindex": {
            "type": "boolean"
          }
