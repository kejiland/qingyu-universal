          "ok",
          "version",
          "storage",
          "database",
          "databaseStatus",
          "posts",
          "migrations",
          "uptime"
        ],
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "管理员会话 token（POST /api/admin/login 获取）或 BLOG_WRITE_TOKEN"
      }
    }
  },
  "paths": {
    "/api/posts": {
      "get": {
        "tags": [
          "文章"
        ],
        "summary": "文章列表",
        "operationId": "getApiPosts",
        "responses": {
          "200": {
            "description": "文章摘要列表。上游可能返回 public 缓存头；写操作一律 no-store",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PostListResponse"
                }
              }
            }
          },
          "401": {
            "description": "请求了后台模式但缺少有效凭证",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "description": "默认只返回已发布文章摘要（不含正文，非受保护文章附带 search 片段）。带 full=1 或 all=1 时视为后台接口，需要管理员凭证，且会返回草稿。带 page + per 时返回服务端分页结果。",
        "parameters": [
          {
            "name": "full",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "all",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "per",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ]
      },
      "post": {
        "tags": [
          "文章"
        ],
        "summary": "新建文章",
        "operationId": "postApiPosts",
        "responses": {
          "201": {
            "description": "创建成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PostResponse"
                }
              }
            }
          },
          "400": {
            "description": "缺少 id / title，或定时发布缺少发布时间",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "未授权",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "id 已存在",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "description": "id 与 title 必填。id 已存在返回 409，请改用 PUT。status=scheduled 时必须提供 publishAt。",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "date": {
                    "type": "string"
                  },
                  "excerpt": {
                    "type": "string"
                  },
                  "content": {
                    "type": "string"
                  },
                  "cover": {
                    "type": "string"
                  },
                  "ogImage": {
                    "type": "string"
                  },
                  "og_image": {
                    "type": "string"
                  },
                  "pinned": {
                    "type": [
                      "boolean",
                      "number"
                    ]
                  },
                  "protected": {
                    "type": [
                      "boolean",
                      "number"
                    ]
                  },
                  "enc": {},
                  "category": {
                    "type": "string"
                  },
                  "series": {
                    "type": "string"
                  },
                  "seriesOrder": {
                    "type": [
                      "number",
                      "string"
                    ]
                  },
                  "series_order": {
                    "type": [
                      "number",
                      "string"
                    ]
                  },
                  "author": {
                    "type": "string"
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "published",
                      "draft",
                      "scheduled"
                    ]
                  },
                  "publishAt": {
                    "type": [
                      "number",
                      "string"
                    ]
                  },
                  "publish_at": {
                    "type": [
                      "number",
                      "string"
                    ]
                  },
                  "seo": {
                    "$ref": "#/components/schemas/Seo"
                  },
                  "tags": {
                    "anyOf": [
                      {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      {
                        "type": "string"
                      }
                    ]
                  }
                },
                "required": [
                  "id",
                  "title"
                ],
                "additionalProperties": false
              }
            }
          }
        }
      }
    },
    "/api/posts/{id}": {
      "get": {
        "tags": [
          "文章"
        ],
        "summary": "文章详情",
        "operationId": "getApiPostsById",
        "responses": {
          "200": {
            "description": "文章详情",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PostResponse"
                }
              }
            }
          },
          "404": {
            "description": "文章不存在，或对匿名访问者不可见",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "description": "返回完整文章（含正文）。草稿与定时发布的文章只对管理员可见，匿名访问返回 404（避免草稿全文泄漏）。受保护文章的 content 恒为空字符串，密文在 enc 中。",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ]
      },
      "put": {
        "tags": [
          "文章"
        ],
        "summary": "更新文章",
        "operationId": "putApiPostsById",
        "responses": {
          "200": {
            "description": "更新成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PostResponse"
                }
              }
            }
          },
          "400": {
            "description": "缺少 title，或定时发布缺少发布时间",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "未授权",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "description": "按 id 覆盖写入（UPSERT）。id 由路径决定，正文里的 id 会被忽略。未提供 date 时沿用原日期。",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "date": {
                    "type": "string"
                  },
                  "excerpt": {
                    "type": "string"
                  },
                  "content": {
                    "type": "string"
                  },
                  "cover": {
                    "type": "string"
                  },
                  "ogImage": {
                    "type": "string"
                  },
                  "og_image": {
                    "type": "string"
                  },
                  "pinned": {
                    "type": [
                      "boolean",
                      "number"
                    ]
                  },
                  "protected": {
                    "type": [
                      "boolean",
                      "number"
                    ]
                  },
                  "enc": {},
                  "category": {
                    "type": "string"
                  },
                  "series": {
                    "type": "string"
                  },
                  "seriesOrder": {
                    "type": [
                      "number",
                      "string"
                    ]
                  },
                  "series_order": {
                    "type": [
                      "number",
                      "string"
                    ]
                  },
                  "author": {
                    "type": "string"
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "published",
                      "draft",
                      "scheduled"
                    ]
                  },
                  "publishAt": {
                    "type": [
                      "number",
                      "string"
                    ]
                  },
                  "publish_at": {
                    "type": [
                      "number",
                      "string"
                    ]
                  },
                  "seo": {
                    "$ref": "#/components/schemas/Seo"
                  },
                  "tags": {
                    "anyOf": [
                      {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      {
                        "type": "string"
                      }
                    ]
                  },
                  "id": {
                    "type": "string"
                  }
                },
                "required": [
                  "title"
                ],
                "additionalProperties": false
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "文章"
        ],
        "summary": "删除文章",
        "operationId": "deleteApiPostsById",
        "responses": {
          "200": {
            "description": "删除成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OkResponse"
                }
              }
            }
          },
          "401": {
            "description": "未授权",
