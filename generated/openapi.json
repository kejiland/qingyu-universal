          },
          "category": {
            "type": "string"
          },
          "series": {
            "type": "string"
          },
          "author": {
            "type": "string"
          },
          "seriesOrder": {
            "type": "number"
          },
          "status": {
            "type": "string",
            "enum": [
              "published",
              "draft",
              "scheduled"
            ]
          },
          "publishAt": {
            "type": [
              "number",
              "null"
            ]
          },
          "seo": {
            "$ref": "#/components/schemas/Seo"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "content": {
            "type": "string"
          },
          "enc": {}
        },
        "required": [
          "id",
          "title",
          "date",
          "excerpt",
          "cover",
          "ogImage",
          "pinned",
          "protected",
          "category",
          "series",
          "author",
          "seriesOrder",
          "status",
          "publishAt",
          "seo",
          "tags",
          "content",
          "enc"
