    "/api/posts/{id}/comments": {
      "get": {
        "tags": [
          "评论"
        ],
        "summary": "评论列表",
        "operationId": "getApiPostsByIdComments",
        "responses": {
          "200": {
            "description": "评论列表",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommentListResponse"
                }
              }
            }
          }
        },
        "description": "默认按「置顶 → 精选 → 点赞 → 时间」排序；sort=new 改为按时间倒序。带 page + per 时按根评论分页，子回复跟随父评论返回。响应不缓存（no-store）。",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "new",
                "hot"
              ]
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "per",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ]
      },
      "post": {
        "tags": [
          "评论"
        ],
        "summary": "发表评论",
        "operationId": "postApiPostsByIdComments",
        "responses": {
          "200": {
            "description": "被反机器人机制静默丢弃",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommentCreateResponse"
                }
              }
            }
          },
          "201": {
            "description": "发表成功（可能为待审核状态）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommentCreateResponse"
                }
              }
            }
          },
          "400": {
            "description": "昵称/内容为空、命中敏感词、父评论无效或评论数达上限",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "重复内容",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "description": "公开接口。author 与 content 必填；支持最多 3 层嵌套回复（parent_id）。命中敏感词返回 400，内容重复返回 409。蜜罐字段（hp / website）被填写时返回 200 且 filtered=true，但不会入库（反机器人）。",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "author": {
                    "type": "string",
                    "minLength": 1
                  },
                  "content": {
                    "type": "string",
                    "minLength": 1
                  },
                  "parent_id": {
                    "type": "string"
                  },
                  "hp": {
                    "type": "string"
                  },
                  "website": {
                    "type": "string"
                  },
                  "ts": {
                    "type": [
                      "number",
                      "string"
                    ]
                  }
                },
                "required": [
                  "author",
                  "content"
                ],
                "additionalProperties": false
              }
            }
          }
        }
      }
    },
