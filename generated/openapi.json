          },
          "seriesOrder": {
            "type": "number"
          },
          "status": {
            "type": "string",
            "enum": [
              "published",
              "draft",
              "scheduled"
            ]
          },
          "publishAt": {
            "type": "null"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "snippet": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "date",
          "excerpt",
          "cover",
          "ogImage",
          "pinned",
          "protected",
          "category",
          "series",
          "seriesOrder",
          "status",
          "publishAt",
          "tags",
          "snippet"
        ],
        "additionalProperties": false
      },
      "SettingsResponse": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "const": true
          },
          "settings": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "required": [
          "ok",
          "settings"
        ],
        "additionalProperties": false
      },
      "HealthResponse": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "version": {
            "type": "string"
          },
          "storage": {
            "type": "string",
            "enum": [
              "local",
              "s3"
            ]
          },
          "database": {
            "type": "string"
          },
          "databaseStatus": {
            "type": "string",
            "enum": [
              "ok",
              "error"
            ]
          },
          "posts": {
            "type": "number"
          },
          "migrations": {
            "type": "object",
            "properties": {
              "applied": {
                "type": "number"
              },
              "skipped": {
                "type": "number"
              }
            },
            "required": [
              "applied",
              "skipped"
            ],
            "additionalProperties": false
          },
          "uptime": {
            "type": "number"
          }
        },
