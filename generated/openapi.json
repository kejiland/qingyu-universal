          "content": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "parent_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "likes": {
            "type": "number"
          },
          "featured": {
            "type": "number"
          },
          "pinned": {
            "type": "number"
          },
          "rid": {
            "type": "number"
          }
        },
        "required": [
          "id",
          "post_id",
          "author",
          "content",
          "date",
          "status"
        ],
        "additionalProperties": false
      },
      "CommentCreateResponse": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "const": true
          },
          "comment": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/CommentCreated"
              },
              {
                "type": "null"
              }
            ]
          },
          "filtered": {
            "type": "boolean"
          }
        },
        "required": [
          "ok",
          "comment"
        ],
        "additionalProperties": false
      },
      "CommentCreated": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "author": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "parent_id": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "author",
          "content",
          "date",
          "status",
          "parent_id"
        ],
        "additionalProperties": false
      },
      "SearchResponse": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "const": true
          },
          "query": {
            "type": "string"
          },
          "engine": {
            "type": "string"
          },
          "page": {
            "type": "number"
          },
          "pageSize": {
            "type": "number"
          },
          "total": {
            "type": "number"
          },
          "totalPages": {
            "type": "number"
          },
          "hasMore": {
            "type": "boolean"
          },
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SearchResult"
            }
          }
        },
        "required": [
          "ok",
          "query",
          "engine",
          "page",
          "pageSize",
          "total",
          "totalPages",
          "hasMore",
          "results"
        ],
        "additionalProperties": false
      },
      "SearchResult": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "excerpt": {
            "type": "string"
          },
          "cover": {
            "type": "string"
          },
          "ogImage": {
            "type": "string"
          },
          "pinned": {
