# ============================================================
# Caddy 反向代理 + 自动 HTTPS
# ------------------------------------------------------------
# 域名由 compose 的 SITE_DOMAIN 注入；未配置时用 localhost（自签证书）。
# 上游注入 X-Forwarded-*，应用据此识别真实客户端 IP（限流/统计）。
# ============================================================
{
	admin off
	servers {
		protocols h1 h2
	}
}

# 站点标签 = 主域名 + 空格分隔的别名域名（借鉴 kejilion 的「一个站点绑多个域名」）。
# 别名由 SITE_ALIASES 注入（空格分隔），Caddy 会为每一个都自动申请 HTTPS 证书。
# 只有一个域名时别名是空的，行为与之前完全一致。
{$SITE_DOMAIN:localhost} {$SITE_ALIASES} {
	encode zstd gzip

	# 上传（图片 10MB / 音乐 30MB / 备份）留足余量
	request_body {
		max_size 64MB
	}

	reverse_proxy app:8787 {
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}
		header_up Host {host}
	}

	header {
		-Server
	}
}