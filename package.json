{
  "name": "qingyu-universal",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Qingyu Blog · 自托管通用版（TypeScript + Hono + SQLite，可选 S3 / SMTP / OpenAI 兼容 AI）",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "migrate": "node dist/cli/migrate.js",
    "seed": "node dist/cli/seed.js",
    "health": "node dist/cli/health.js",
    "backup": "node dist/cli/backup.js",
    "restore": "node dist/cli/restore.js",
    "smoke": "node dist/cli/smoke.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "sync:upstream": "node scripts/apply-upstream-adapters.mjs",
    "openapi:emit": "node dist/cli/openapi.js",
    "api:types": "openapi-typescript generated/openapi.json -o generated/api.d.ts",
    "api:generate": "npm run build && npm run openapi:emit && npm run api:types",
    "typecheck:tests": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "dotenv": "^17.4.2",
    "hono": "^4.13.13",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.0.14",
    "pino": "^10.4.0",
    "pino-pretty": "^13.1.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.2",
    "openapi-typescript": "^7.13.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
